PROJECT_NAME=code_base
ENVIRONMENT=local  # local/dev/qa/stg/prod

API_PORT=8000
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

AWS_REGION='us-east-2'
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=your-session-token

TOKEN_SECRET=your-token-secret  # legacy fallback, prefer JWT_SECRET_KEY

PRE_START_PATH=scripts/prestart.sh

SLACK_HOOK_URL=https://hooks.slack.com/services/your-webhook-url

SLACK_TIMEOUT_SECONDS=5.0
SLACK_MAX_RETRIES=2
SLACK_RETRY_BACKOFF_SECONDS=0.5

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=60
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=2592000
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=30

# MinIO Configuration
S3_ENDPOINT_URL=http://minio:9000
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit Configuration
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
EMAIL_FROM=noreply@example.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

